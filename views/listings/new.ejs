<% layout('layouts/boilerplate')%>
<body>
    <form  method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="row">
            <div class="col-8 offset-2">
               
                <h3>Create a New Listing</h3>
                  <br>
        <div class="mb-3">
            <lable for="title" class="form-lable">Title</lable>
             <input name="listing[title]" placeholder="Enter title" type="text" class="form-control" required>
             <div class="valid-feedback">Title looks good</div>
            
        </div>
       
             <div class="mb-3">
                <lable for="Description" class="form-lable">Description</lable>
                <input name="listing[description]" placeholder="Enter description" type="text" class="form-control" required>
                     <div class="invalid-feedback">enter a short description</div>
        </div>
<!-- 
             <div class="mb-3">
                <lable for="Image" class="form-lable">Image Link</lable>
                <input name="listing[image]" placeholder="Enter image/URL link" type="text" class="form-control" >

        </div> -->

             <div class="mb-3">
                <lable for="Image" class="form-lable">Upload Image</lable>
                <input name="listing[image]"  type="file" class="form-control" >
                required
        </div>
        <div class="row">
            
           <div class="mb-3 col-md-4">
                <lable for="price" class="form-lable">Price</lable>
                <input name="listing[price]" placeholder="Enter price" type="number" class="form-control" required>
                     <div class="invalid-feedback">enter a valid price</div>
       </div>

       <div class="mb-3 col-md-8">
                <lable for="country" class="form-lable">Country</lable>
                <input name="listing[country]" placeholder="Enter country" type="text" class="form-control" required>
                     <div class="invalid-feedback">enter a valid county name</div>
        </div>

        </div>

             <div class="mb-3">
                <lable for="location" class="form-lable">Location</lable>
                 <input name="listing[location]" placeholder="Enter location" type="text" class="form-control" required>
                     <div class="invalid-feedback">enter a valid location</div>
                     
        </div>
            <br>
        <button class="btn btn-dark add-btn" > Add Listing</button>
    </form>
    </div>
    </div>
</body>
