<% layout('layouts/boilerplate')%>
<div class="row mt-3">
    <h1 class="col-6 offset-3">Signup to Wanderlust</h1>
    <div class="col-6 offset-3">
        <form action="/signup"method="POST" class="needs-validation" novalidate>
                <div class="mb-3">
            <lable for="username" class="form-lable">Username</lable>
             <input name="username" placeholder="Enter username" type="text" class="form-control" required>
             <div class="valid-feedback">Username looks good</div>
            
        </div>


              <div class="mb-3">
            <lable for="email" class="form-lable">Email</lable>
             <input name="email" placeholder="Enter email" type="email" class="form-control" required>
             <div class="valid-feedback">Email looks good</div>
            
        </div>


              <div class="mb-3">
            <lable for="password" class="form-lable">Password</lable>
             <input name="password" placeholder="Enter password" type="password" class="form-control" required>
             <div class="valid-feedback">Password looks good</div>
            
        </div>

       
               <button type="submit" class="btn btn-success">Signup</button>

        </form>

    </div>
</div>